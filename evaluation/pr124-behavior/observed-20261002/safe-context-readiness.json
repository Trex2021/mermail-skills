        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "mailboxId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Mailbox public_id returned by list_mailboxes (preferred); hosted alias id or current email also works."
          },
          "emailId": {
            "type": "string",
